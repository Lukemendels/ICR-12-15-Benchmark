{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://paperclip.local/schemas/paperclip.tool.schema.json","title":"Paperclip tool project manifest","type":"object","additionalProperties":false,
  "required":["schemaVersion","id","title","version","source","output","skill","prompts","dependencies","stickshiftInstallable"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":64},
    "title":{"type":"string","minLength":1,"maxLength":120},
    "version":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "source":{"type":"object","additionalProperties":false,"required":["html","css","javascript"],"properties":{"html":{"$ref":"#/$defs/path"},"css":{"$ref":"#/$defs/path"},"javascript":{"$ref":"#/$defs/path"}}},
    "output":{"$ref":"#/$defs/path"},
    "skill":{"oneOf":[{"type":"object","additionalProperties":false,"required":["mode","path","slug"],"properties":{"mode":{"const":"authored"},"path":{"$ref":"#/$defs/path"},"slug":{"$ref":"#/$defs/id"}}},{"type":"object","additionalProperties":false,"required":["mode","slug"],"properties":{"mode":{"const":"generated"},"slug":{"$ref":"#/$defs/id"}}}]},
    "prompts":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/path"}},
    "dependencies":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","version","path"],"properties":{"id":{"$ref":"#/$defs/id"},"version":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},"path":{"$ref":"#/$defs/path"}}}},
    "stickshiftInstallable":{"type":"boolean"}
  },
  "$defs":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":64},"path":{"type":"string","minLength":1,"maxLength":240,"pattern":"^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"}}
}
